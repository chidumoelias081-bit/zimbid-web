# Where the ZimBid API is running.
# On your own computer the website forwards /api to this address:
API_URL=http://localhost:3000
# When the website is hosted separately (for example on Netlify), set this instead, to the API's public address.
# It is read when the site is built, so redeploy after changing it. No trailing slash.
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
